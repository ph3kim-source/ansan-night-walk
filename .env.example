# 3안 인증키 양식 (수정사항 #17)
# 이 파일을 같은 폴더에 '.env' 로 복사하고 = 뒤에 값을 채운다. 따옴표는 없어도 된다.
# .env 는 공유본(build_share.py)과 드라이브 앱(build_app_folders.py)에 들어가지 않는다.
# 키 값을 채팅 · 코드 · 문서에 적지 않는다. 다 채웠으면:  py -3.12 src/collect_api.py check

# 1. SGIS(국가데이터처 통계지리정보서비스) — sgis.mods.go.kr → 개발지원센터 → 인증키 신청
#    집계구 경계 · 집계구별 인구 · 가구 · 주택 · 사업체
SGIS_KEY=
SGIS_SECRET=

# 2. 브이월드(국토교통부 공간정보 오픈플랫폼) — vworld.kr → 오픈API → 인증키 발급
#    VWORLD_DOMAIN 에는 신청서에 등록한 서비스 URL 을 그대로(예: https://ph3kim-source.github.io). 이 키는 시민 앱 바탕지도에도 실린다(#41)
#    건축물 · 도로명주소 건물/도로 · 교통링크 · 용도지역 · 산업단지
VWORLD_KEY=
VWORLD_DOMAIN=https://ph3kim-source.github.io

# 3. 공공데이터포털 — data.go.kr → 「행정안전부_CCTV정보 조회서비스」(15155042) 활용신청
#    마이페이지 → 일반 인증키(Decoding). Encoding 키를 넣어도 된다
DATA_GO_KR_KEY=

# ── 실사용 앱 단계에서 (지금 수집에는 쓰지 않음 — 응답을 저장할 수 없거나 수집 수단이 아님) ──
# 카카오 developers.kakao.com → 내 애플리케이션 → REST API 키, [카카오맵] 사용 설정 ON
# KAKAO_REST_KEY=
# 네이버 클라우드 console.ncloud.com → Maps → Application 등록 (결제수단 등록 필요)
# NCP_CLIENT_ID=
# NCP_CLIENT_SECRET=
